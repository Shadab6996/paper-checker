generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Student {
  id           String       @id @default(cuid())
  name         String
  section      String       @default("A")
  loginId      String       @unique
  passwordHash String
  passwordPlain String?
  createdAt    DateTime     @default(now())
  submissions  Submission[]

  @@index([section])
}

model Test {
  id                String       @id @default(cuid())
  code              String       @unique
  name              String
  subject           String
  chapterName       String
  section           String?
  startTime         DateTime
  endTime           DateTime
  questionPaperPath String?
  answerKeyPath     String?
  createdAt         DateTime     @default(now())
  submissions       Submission[]
}

model Settings {
  id        String   @id @default("singleton")
  heroNames String[] @default([])
  heroQuote String   @default("The best answer sheet is the one that actually gets submitted.")
  updatedAt DateTime @updatedAt
}

model Submission {
  id          String   @id @default(cuid())
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  testId      String
  test        Test     @relation(fields: [testId], references: [id], onDelete: Cascade)
  storagePath String
  submittedAt DateTime @default(now())

  gradeStatus   String    @default("ungraded")
  aiScore       Float?
  aiMaxScore    Float?
  aiFeedback    Json?
  gradeError    String?
  finalScore    Float?
  finalFeedback String?
  gradedAt      DateTime?
  approvedAt    DateTime?

  @@index([testId])
  @@index([studentId])
}
